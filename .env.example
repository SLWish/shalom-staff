# Supabase public values
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only values. Never expose this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: protect scheduled/manual collection endpoints later.
COLLECT_SECRET=change-this-to-a-long-random-string

# Defeat alert email delivery through a dedicated Gmail account (server-only)
GMAIL_USER=your-alert-account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
DEFEAT_FROM_NAME=ShaLom Wave Ops
# Optional override. Netlify's built-in URL value is used when omitted.
DEFEAT_SITE_URL=https://your-site.netlify.app
DEFEAT_LINK_SECRET=change-this-to-another-long-random-string
DEFEAT_ADMIN_TOKEN=change-this-to-a-private-admin-token
