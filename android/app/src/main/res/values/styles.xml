<resources>
    <style name="Theme.ShaLomAdmin" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/background</item>
    </style>
    <style name="Theme.ShaLomAdmin.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:navigationBarColor">#11131A</item>
        <item name="android:statusBarColor">#11131A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#11131A</item>
    </style>
</resources>
